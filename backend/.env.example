# AI Services
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Transcription Services
GROQ_API_KEY=your_groq_api_key_here

# Social Download APIs (Optional fallbacks)
RAPIDAPI_KEY=
COBALT_API_URL=https://co.wuk.sh

# Database Options:
# 1. Neon (Recommended for serverless Postgres):
#    Paste your pooled connection string from the Neon Console:
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Supabase (Alternative):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_anon_key

# (If both are left blank, the app automatically runs on local SQLite)

# App Configuration
PORT=8000
STORAGE_DIR=./storage

# In production, add your live frontend domain (e.g. Vercel) or keep ["*"]
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "https://*.vercel.app", "*"]
